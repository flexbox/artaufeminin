{
  "Main": {
    "uid": {
      "type": "UID",
      "config": {
        "label": "slug",
        "placeholder": "Url de la critique du livre"
      }
    },
    "title": {
      "type": "StructuredText",
      "config": {
        "single": "heading1",
        "label": "title",
        "placeholder": "titre du livre"
      }
    },
    "description": {
      "type": "StructuredText",
      "config": {
        "multi": "strong,em",
        "label": "description",
        "placeholder": "Court résumé du livre pour donner envie de le lire"
      }
    },
    "image": {
      "type": "Image",
      "config": {
        "constraint": {},
        "thumbnails": [],
        "label": "image"
      }
    },
    "content": {
      "type": "StructuredText",
      "config": {
        "multi": "paragraph, heading2, heading3, heading4, strong, em, hyperlink, image, embed, list-item, o-list-item",
        "allowTargetBlank": true,
        "label": "content",
        "placeholder": "Critique / avis sur le livre"
      }
    }
  }
}
